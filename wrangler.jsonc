{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesh",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "routes": [{ "pattern": "mesh.finereli.com", "custom_domain": true }],

  // People, agents, grants, sealed conversations. Schema: src/schema.sql
  //   npx wrangler d1 execute mesh-v2 --remote --file src/schema.sql
  "d1_databases": [{ "binding": "DB", "database_name": "mesh-v2", "database_id": "f8cfa5cf-2461-4b52-9040-d433d4a6a0b2" }],

  // The OAuth provider's token store, plus pending sign-ins.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3852508f7dfc46b9a05d3d3eafbf5e83" }],

  // Email for invites and approval requests. send_email only reaches addresses verified in Email Routing,
  // so it can't write to strangers.
  "send_email": [{ "name": "MAIL" }],

  // Who may sign in while this is a test is a secret, so the list stays out of the repo:
  //   echo "a@example.com,b@example.com" | npx wrangler secret put ALLOWED_EMAILS
  "vars": { "MAIL_FROM": "mesh@finereli.com" },

  // The daemon script, served at /agent.mjs.
  "rules": [{ "type": "Text", "globs": ["**/*.mjs"], "fallthrough": true }]
}
